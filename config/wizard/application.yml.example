general:
  clientUrl: http://localhost:3001
  secret:
  privacyUrl:
  termsOfServiceUrl:

database:
  connectionString: postgresql://postgres:postgres@postgres:5432/wizard
  # The vacuum cleaner runs raw VACUUM statements, so the table names are not checked at
  # startup.
  # vacuumCleaner:
  #   enabled: true
  #   cron: "0 3 * * *"
  #   tables:
  #     - project
  #     - knowledge_model_package
  #     - registry_knowledge_model_package

# Presence rows without a heartbeat for 2 minutes and outbox rows older than 5 minutes are
# deleted by these jobs.
# websocket:
#   cleanConnections:
#     enabled: true
#     cron: "* * * * *"
#   cleanOutbox:
#     enabled: true
#     cron: "*/5 * * * *"

httpClient:
  restricted:
    allowedHosts: []

sentry:
  enabled: false
  dsn:
  environment: development
